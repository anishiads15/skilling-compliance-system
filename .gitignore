# Environment variables and secrets
.env
.env.local
.env.*.local

# Python compiled files and cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# Local databases (automatically created/seeded by database.py)
*.db
*.sqlite

# Large raw video footage dumps (> 100MB)
*.avi
static/uploads/SIH Footage/
frontend/uploads/SIH Footage/

# Heavy pretrained neural model checkpoints (> 50MB)
weights/clip/
backend/weights/clip/
backend/weights/head_yolov8n.pt

# OS specific files
Thumbs.db
.DS_Store
