# =====================================================================
# EmailJS REST API Configuration for Training Centre Compliance System
# =====================================================================
# Service ID from EmailJS Dashboard > Email Services
EMAILJS_SERVICE_ID=service_71zfxw8

# Template ID from EmailJS Dashboard > Email Templates
# (Configured with parameters {{to_email}} and {{otp}})
EMAILJS_TEMPLATE_ID=template_qlc56qj

# Public Key from EmailJS Dashboard > Account > API Keys
EMAILJS_PUBLIC_KEY=_8N3Y4amvpvUyzYH5

# Optional Private Key (accessToken) for server-to-server API calls
# Found at https://dashboard.emailjs.com/admin/account/security
EMAILJS_PRIVATE_KEY=

# Allowed Origin (default is local web server origin)
EMAILJS_ORIGIN=http://127.0.0.1:5000

# =====================================================================
# Security Notice:
# - Never commit real credentials or .env to version control.
# - Keep .env excluded in .gitignore.
# =====================================================================
